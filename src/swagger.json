{
  "openapi": "3.0.3",
  "info": {
    "title": "Soulreach",
    "description": "Soulreach API documentaion",
    "version": "0.0.1"
  },
  "servers": [ 
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local development server for soulreach API"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterUser": {
        "type": "object",
        "required": ["username", "churchName", "region", "email", "password", "role"],
        "properties": {
          "username": {
            "type": "string",
            "example": "John Doe"
          },
          "churchName": {
            "type": "string",
            "example": "Grace Chapel"
          },
          "region": {
            "type": "string",
            "example": "Eastern Region"
          },
          "subRegionalOverseer": {
            "type": "string",
            "example": "650912c6fd6fd4h2b4f31f2r"
          },
          "regionalOverseer": {
            "type": "string",
            "example": "650912c6fd6fd4h2b4f31f2r"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "securePassword123"
          },
          "role": {
            "type": "string",
            "enum": ["PASTOR", "SUB_REGIONAL_OVERSEER", "REGIONAL_OVERSEER", "BISHOP"],
            "example": "PASTOR"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "message": {
            "type": "string",
            "example": "Account created successfully"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "securePassword123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "650912c6fd6fd4h2b4f31f2r"
              },
              "username": {
                "type": "string",
                "example": "John Doe"
              },
              "churchName": {
                "type": "string",
                "example": "Grace Chapel"
              },
              "region": {
                "type": "string",
                "example": "Eastern Region"
              },
              "role": {
                "type": "string",
                "example": "PASTOR"
              }
            }
          }
        }
      },
      "CreateRegionRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Western Region"
          }
        }
      },
      "CreateRegionResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Region created successfully"
          },
          "region": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "example": "650912c6fd6fd4h2b4f31f2r"
              },
              "name": {
                "type": "string",
                "example": "Western Region"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "SoulWinningRecord": {
        "type": "object",
        "required": ["minister", "date", "soulsWon", "contacts", "eventName"],
        "properties": {
          "minister": {
            "type": "string",
            "example": "650912c6fd6fd4h2b4f31f2r"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "soulsWon": {
            "type": "number",
            "example": 5
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "John Doe"
                },
                "phoneNumber": {
                  "type": "string", 
                  "example": "+233241234567"
                }
              }
            }
          },
          "eventName": {
            "type": "string",
            "example": "Sunday Evangelism"
          }
        }
      },
      "SubRegionRequest": {
        "type": "object",
        "required": ["region", "name"],
        "properties": {
          "region": {
            "type": "string",
            "example": "650912c6fd6fd4h2b4f31f2r"
          },
          "name": {
            "type": "string",
            "example": "North West Sub-Region"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "description": "Register a new user with role-specific validation. PASTOR role requires both regional and sub-regional overseers. SUB_REGIONAL_OVERSEER requires regional overseer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid input or email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Please provide all required fields"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to register user"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "description": "Authenticate user with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid email or password"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to login"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/region/create": {
      "post": {
        "tags": ["Region Management"],
        "summary": "Create a new region",
        "description": "Create a new region in the system. Currently restricted to BISHOP role.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Region successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRegionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid input or region already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Region already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to create region"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/soulWinning/create": {
      "post": {
        "tags": ["Soul Winning"],
        "summary": "Create a soul winning record",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoulWinningRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Record created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SoulWinningRecord"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/soulWinning/getRecords/{ministerId}": {
      "get": {
        "tags": ["Soul Winning"],
        "summary": "Get soul winning records for a specific minister",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "ministerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Records fetched successfully"
          }
        }
      }
    },
    "/region/createSubRegion": {
      "post": {
        "tags": ["Region Management"],
        "summary": "Create a new sub-region",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubRegionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sub-region created successfully"
          }
        }
      }
    },
    "/region/getSubRegions/{region}": {
      "get": {
        "tags": ["Region Management"],
        "summary": "Get all sub-regions for a region",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sub-regions fetched successfully"
          }
        }
      }
    },
    "/soulWinning/soulWinningRecords": {
      "get": {
        "tags": ["Soul Winning"],
        "summary": "Get all soul winning records for a region",
        "description": "Retrieves all soul winning records for pastors under a Regional Overseer's jurisdiction",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Region soul winning records fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Region soul winning records fetched successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SoulWinningRecord"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to fetch region soul winning records"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/soulWinning/subRegionSoulWinningRecords": {
      "get": {
        "tags": ["Soul Winning"],
        "summary": "Get all soul winning records for a sub-region",
        "description": "Retrieves all soul winning records for pastors under a Sub-Regional Overseer's jurisdiction",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Sub region soul winning records fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Sub region soul winning records fetched successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SoulWinningRecord"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to fetch sub region soul winning records"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/soulWinning/getAllSoulWinningRecords": {
      "get": {
        "tags": ["Soul Winning"],
        "summary": "Get all soul winning records (Bishop only)",
        "description": "Retrieves all soul winning records across all regions (restricted to Bishop role)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "All soul winning records fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "All soul winning records fetched successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SoulWinningRecord"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Region Management",
      "description": "Endpoints for managing church regions"
    },
    {
      "name": "Soul Winning",
      "description": "Endpoints for managing soul winning records"
    }
  ]
}
